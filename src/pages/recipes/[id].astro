---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry } from "astro:content";

export const prerender = true;
export const getStaticPaths = (async () => {
	const recipes = await getCollection("recipes");

	return recipes.map((recipe) => ({
		params: { id: recipe.id },
		props: { ...recipe.data },
	}));
}) satisfies GetStaticPaths;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import { colorFromString } from "../../utils/colorFromString";
const recipe = await getEntry("recipes", Astro.params.id);
const { title, image, imageAlt, ingredients, steps } = Astro.props;
const stepGroupName = `recipe-step-${Astro.params.id}`;
const bgColor = image ? undefined : colorFromString(title);
---

<BaseLayout title={title} description={`Rezept für ${title}`}>
	<main>
		<a href="/">
			<h1>{title}</h1>
		</a>
		<div class="ingredients-header">
			<h2 id="ingredients-heading">Zutaten</h2>
			<div class="ingredient-scale-controls" aria-label="Zutatenmenge anpassen">
				<button type="button" id="scale-half" aria-label="Zutaten halbieren" aria-pressed="false">1/2x</button>
				<button type="button" id="scale-reset" aria-label="Originalmengen verwenden" aria-pressed="true">1x</button>
				<button type="button" id="scale-double" aria-label="Zutaten verdoppeln" aria-pressed="false">2x</button>
			</div>
		</div>
		<ul class="ingredients" aria-labelledby="ingredients-heading">
			{
				ingredients.map((ingredient, index) => (
					<li>
						<input type="checkbox" id={"i" + index} title={ingredient + " hinzugefügt"} />
						<label for={"i" + index}><span class="ingredient-text">{ingredient}</span></label>
					</li>
				))
			}
		</ul>
		<input type="radio" id="step-reset" name={stepGroupName} class="step-reset" checked />
		<h2 id="steps-heading"><label for="step-reset">Zubereitung</label></h2>
		<ol class="steps" aria-labelledby="steps-heading">
			{steps.map((step, index) => (
					<li>
						<input type="radio" id={`step-${index}`} name={stepGroupName} />
						<label for={`step-${index}`}>{step}</label>
					</li>
				))}
		</ol>
		{recipe?.rendered?.html && <section set:html={recipe?.rendered?.html} />}
	</main>
	<aside>
		{image && <Picture 
								width=500 
								src={image}
								alt={imageAlt ?? ""}
								formats={["webp", "jpg"]}
								transition:name={`recipe-image-${Astro.params.id}`}
							 />}
	</aside>
</BaseLayout>

<style>
	:root {
		max-width: 500px;
		margin-inline: auto;
	}

  main {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.2em;

		padding-inline: 0.4em;
	}

	.step-reset {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	h2 > label {
		cursor: pointer;
		display: block;
	}

	main > a > h1 {
		text-align: center;
		margin-block: 0.1em;
	}

	main > a:has(h1) {
		position: relative;
		cursor: pointer;
		text-decoration: none;
		color: var(--color-text);

		::before {
			content: "←";
			font-weight: bold;
			position: absolute;
			left: 1em;
			opacity: 0;
			transition: all var(--animation-speed) var(--animation-easing);
		}
		&:hover, &:focus {
			::before {
				left: 0;
				opacity: 1;
			}
		}
	}

	h2 {
		padding: 0;
		margin: 0;
	}

	.ingredients-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.ingredient-scale-controls {
		display: flex;
		gap: 0.4rem;

		button {
			border: 1px solid color-mix(in srgb, var(--color-text) 25%, transparent);
			border-radius: var(--border-radius);
			background: var(--color-background);
			color: var(--color-text);
			padding: 0.2rem 0.5rem;
			cursor: pointer;
			font: inherit;
		}

		button[aria-pressed="true"] {
			background: var(--color-highlight);
		}
	}

	.ingredients, .steps {
		padding: 0;
		margin: 0;
		
		li {
			margin-block: 0.2em;
			list-style: none;
			border-radius: var(--border-radius);
			transition: background var(--animation-speed) var(--animation-easing);
			background-color: var(--color-background);
			
			&:has(input:checked) {
				background: var(--color-highlight);
			}
		}

		label {
			display: block;
			padding: 0.4em;
			cursor: pointer;
		}
		
		input {
			display: none;
		}
	}

	.steps {
		counter-reset: step;

		li {
			counter-increment: step;
		}
		label {
			display: block;
			cursor: pointer;
		}
		label::before {
			content: counter(step) ". ";
			font-weight: 600;
		}
		li:has(~ li input:checked) {
			background: var(--color-background);
		}
	}

	aside>picture {
		display: block;
		
		img {
			display: block;
			width: 100%;
			height: auto;
		}
	}
</style>

<script>
	let wakeLock: WakeLockSentinel | null = null;

	// Acquire wake lock on page load if the API is supported
	if ("wakeLock" in navigator) {
		requestWakeLock();

		// Re-acquire wake lock when page becomes visible again
		document.addEventListener("visibilitychange", async () => {
			if (document.visibilityState === "visible") {
				await requestWakeLock();
			}
		});
	}

	const ingredientTextElements = Array.from(document.querySelectorAll<HTMLSpanElement>(".ingredient-text"));
	const originalIngredientTexts = ingredientTextElements.map((element) => element.textContent ?? "");
	const halfButton = document.querySelector<HTMLButtonElement>("#scale-half");
	const doubleButton = document.querySelector<HTMLButtonElement>("#scale-double");
	const resetButton = document.querySelector<HTMLButtonElement>("#scale-reset");
	let currentScaleFactor = 1;
	const singleCharFractions: Record<string, number> = {
		"¼": 1 / 4,
		"½": 1 / 2,
		"¾": 3 / 4,
		"⅐": 1 / 7,
		"⅑": 1 / 9,
		"⅒": 1 / 10,
		"⅓": 1 / 3,
		"⅔": 2 / 3,
		"⅕": 1 / 5,
		"⅖": 2 / 5,
		"⅗": 3 / 5,
		"⅘": 4 / 5,
		"⅙": 1 / 6,
		"⅚": 5 / 6,
		"⅛": 1 / 8,
		"⅜": 3 / 8,
		"⅝": 5 / 8,
		"⅞": 7 / 8,
	};
	const singleCharFractionPattern = new RegExp(`[${Object.keys(singleCharFractions).join("")}]`);
	const quantityPattern = new RegExp(
		`^((?:\\d+(?:[.,]\\d+)?)?${singleCharFractionPattern.source}|\\d+(?:[.,]\\d+)?)(.*)$`,
	);

	if (ingredientTextElements.length && halfButton && doubleButton && resetButton) {
		halfButton.addEventListener("click", () => setIngredientScale(0.5));
		doubleButton.addEventListener("click", () => setIngredientScale(2));
		resetButton.addEventListener("click", resetIngredientScale);
		updateScaleButtonState();
	}

	function setIngredientScale(scaleFactor: number) {
		currentScaleFactor = scaleFactor;
		ingredientTextElements.forEach((ingredientTextElement, index) => {
			const scaledText = scaleIngredientLine(originalIngredientTexts[index], currentScaleFactor);
			if (scaledText !== null) {
				ingredientTextElement.textContent = scaledText;
			} else {
				ingredientTextElement.textContent = originalIngredientTexts[index];
			}
		});
		updateScaleButtonState();
	}

	function resetIngredientScale() {
		currentScaleFactor = 1;
		ingredientTextElements.forEach((ingredientTextElement, index) => {
			ingredientTextElement.textContent = originalIngredientTexts[index];
		});
		updateScaleButtonState();
	}

	function updateScaleButtonState() {
		halfButton?.setAttribute("aria-pressed", String(currentScaleFactor === 0.5));
		resetButton?.setAttribute("aria-pressed", String(currentScaleFactor === 1));
		doubleButton?.setAttribute("aria-pressed", String(currentScaleFactor === 2));
	}

	function scaleIngredientLine(line: string, factor: number): string | null {
		const match = line.match(quantityPattern);
		if (!match) {
			return null;
		}

		const quantity = parseQuantity(match[1]);
		if (quantity === null) {
			return null;
		}

		return `${formatQuantity(quantity * factor)}${match[2]}`;
	}

	function parseQuantity(rawQuantity: string): number | null {
		const normalized = rawQuantity.replace(",", ".").replace(/\s+/g, "");
		const fractionCharacter = normalized.match(singleCharFractionPattern)?.[0];
		if (fractionCharacter) {
			const fractionValue = singleCharFractions[fractionCharacter];
			const wholePartRaw = normalized.replace(fractionCharacter, "");
			const wholePart = wholePartRaw ? Number(wholePartRaw) : 0;
			if (!Number.isFinite(wholePart)) {
				return null;
			}
			return wholePart + fractionValue;
		}

		const quantity = Number(normalized);
		return Number.isFinite(quantity) ? quantity : null;
	}

	function formatQuantity(value: number): string {
		if (Number.isInteger(value)) {
			return String(value);
		}

		const wholePart = Math.trunc(value);
		const fractionalPart = Number((value - wholePart).toFixed(3));
		const fractionCharacter =
			fractionalPart === 0.5 ? "½"
			: fractionalPart === 0.25 ? "¼"
			: fractionalPart === 0.125 ? "⅛"
			: null;
		if (fractionCharacter) {
			return wholePart > 0 ? `${wholePart}${fractionCharacter}` : fractionCharacter;
		}

		return String(Number(value.toFixed(2)));
	}

	async function requestWakeLock() {
		try {
			wakeLock = await navigator.wakeLock.request("screen");
			wakeLock.addEventListener("release", () => {
				wakeLock = null;
			});
		} catch (err) {
			console.error("Wake Lock request failed:", err);
		}
	}
</script>
